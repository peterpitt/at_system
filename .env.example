# ============================================================
#  永豐 Shioaji API 設定（複製此檔為 .env 並填入真實值）
#  切勿將 .env 提交到 Git！（.gitignore 已自動忽略）
# ============================================================

# --- 永豐 API 金鑰（永豐證券官網 / Shioaji 後台申請）---
SINOPAC_API_KEY=
SINOPAC_API_SECRET=

# --- 帳戶資訊 ---
SINOPAC_ACCOUNT_ID=

# --- 憑證路徑與密碼（活化下單權限用，通常密碼為身分證字號）---
SINOPAC_PFX_PATH=./Sinopac.pfx
SINOPAC_PFX_PASSWORD=
# 憑證持有人身分證字號（activate_ca 需要）
SINOPAC_PERSON_ID=

# ============================================================
#  交易模式
# ============================================================
# PAPER = 模擬盤（強烈建議先跑至少數週）
# LIVE  = 實單（真實資金，請謹慎）
TRADING_MODE=PAPER

# 實單安全鎖：唯有此值精確等於 I_UNDERSTAND_THE_RISK，
# 且 TRADING_MODE=LIVE 時，系統才會真正以真實資金下單。
# 這是刻意設計的「第二道確認」，保護你的本金。
CONFIRM_LIVE_TRADING=

# ============================================================
#  資金與風險參數（請務必依自身狀況調整）
# ============================================================
# 帳戶起始可用資金（新台幣）
ACCOUNT_CAPITAL=72000

# 交易商品：TMF = 微型臺指期貨
SYMBOL=TMF

# 每口原始保證金（元）— 會隨期交所公告變動，下單前請至期交所官網確認！
# 系統啟動時會嘗試以 API 取得實際保證金覆蓋此值。
MARGIN_PER_CONTRACT=26300

# 單筆交易風險（佔總資金比例）。0.01 = 1%
RISK_PER_TRADE_PCT=0.01

# 每日最大虧損（佔總資金比例），觸及即當日停止並平倉。0.03 = 3%
MAX_DAILY_LOSS_PCT=0.03

# 帳戶最大回撤（佔起始資金比例），觸及即永久停止。0.15 = 15%
MAX_TOTAL_DRAWDOWN_PCT=0.15

# 同時最大持有口數（72,000 元資金的安全上限為 1 口）
MAX_CONTRACTS=1

# 連續虧損幾筆後當日停止交易
MAX_CONSECUTIVE_LOSSES=3

# ============================================================
#  策略參數
# ============================================================
# K 棒週期（分鐘）
BAR_MINUTES=5
# EMA 快線 / 慢線
EMA_FAST=12
EMA_SLOW=26
# ATR 週期
ATR_PERIOD=14
# 停損 = 進場價 ± ATR × 此倍數
ATR_STOP_MULT=2.0
# 停利 = 進場價 ± ATR × 此倍數（風報比 = TP/SL）
ATR_TP_MULT=3.0
# 只在日盤這段時間進場（HH:MM，24h），收盤前一律平倉
SESSION_START=09:00
SESSION_END=13:25
# 是否啟用夜盤（True/False）
ENABLE_NIGHT_SESSION=False

# ============================================================
#  通知（可選）— Telegram Bot，不填則僅寫入日誌
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
